generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum InvoiceStatus {
  draft
  sent
  paid
  cancelled
}

enum Role {
  admin
  project_manager
  front_seller
}

enum ServiceStatus {
  active
  completed
  cancelled
}

enum ServiceCategory {
  website
  hosting
  security
  seo
  other
}

model User {
  id          Int      @id @default(autoincrement())
  name        String
  email       String   @unique
  password    String
  role        Role
  isUpseller  Boolean  @default(false)
  permissions Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  soldClients     Client[]        @relation("FrontSeller")
  managedClients  Client[]        @relation("ProjectManager")
  upsoldServices  ClientService[] @relation("Upseller")
  soldServices    ClientService[] @relation("SoldBy")
}

model Brand {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  logoUrl     String?
  brandColor  String?  @default("#1a1a2e")
  address     String?  @db.Text
  phone       String?
  email       String?
  website     String?
  clients     Client[]
}

model ServiceType {
  id            Int             @id @default(autoincrement())
  name          String          @unique
  isRecurring   Boolean         @default(false)
  category      ServiceCategory @default(other)
  clientServices ClientService[]
}

model Client {
  id                Int       @id @default(autoincrement())
  name              String
  email             String?
  phone             String?
  medium            String?
  notes             String?   @db.Text
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  brandId           Int?
  brand             Brand?   @relation(fields: [brandId], references: [id])

  frontSellerId     Int?
  frontSeller       User?    @relation("FrontSeller", fields: [frontSellerId], references: [id])
  // Raw agent name from the Sheet, kept even when it doesn't match a User yet
  // (e.g. "Mair" has no login) — so the CRM shows a name instead of blank.
  frontSellerName   String?

  projectManagerId  Int?
  projectManager    User?    @relation("ProjectManager", fields: [projectManagerId], references: [id])
  pmName            String?

  services          ClientService[]
}

model ClientService {
  id             Int           @id @default(autoincrement())
  clientId       Int
  client         Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)

  serviceTypeId  Int
  serviceType    ServiceType   @relation(fields: [serviceTypeId], references: [id])

  upsellerId     Int?
  upseller       User?         @relation("Upseller", fields: [upsellerId], references: [id])
  upsellerName   String?

  soldById       Int?
  soldBy         User?         @relation("SoldBy", fields: [soldById], references: [id])
  soldByName     String?

  description    String?       @db.Text
  totalAmount    Decimal       @db.Decimal(10, 2)
  saleDate       DateTime
  durationYears  Int?
  startDate      DateTime?
  endDate        DateTime?
  status         ServiceStatus @default(active)
  isNewAccount   Boolean       @default(false)
  externalRef    String?       @unique
  deletedAt      DateTime?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  payments       Payment[]
}

model Payment {
  id              Int           @id @default(autoincrement())
  clientServiceId Int
  clientService   ClientService @relation(fields: [clientServiceId], references: [id], onDelete: Cascade)

  amount          Decimal       @db.Decimal(10, 2)
  paymentDate     DateTime
  note            String?
  externalRef     String?       @unique
  deletedAt       DateTime?

  createdAt       DateTime      @default(now())
}

model SellerProfile {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  isActive       Boolean  @default(true)
  isFrontSeller  Boolean  @default(false)
  isUpseller     Boolean  @default(false)
  monthlyTarget  Decimal? @db.Decimal(10, 2)
  frontTarget    Decimal? @db.Decimal(10, 2)
  upsellTarget   Decimal? @db.Decimal(10, 2)
  createdAt      DateTime @default(now())
}

enum StripeMode {
  test
  live
}

model StripeAccount {
  id                  Int        @id @default(autoincrement())
  name                String
  brandId             Int?
  mode                StripeMode @default(test)
  secretKeyTest       String?    @db.Text
  publishableKeyTest  String?
  secretKeyLive       String?    @db.Text
  publishableKeyLive  String?
  isActive            Boolean    @default(true)
  createdAt           DateTime   @default(now())
  invoices            Invoice[]
}

model Invoice {
  id                   Int           @id @default(autoincrement())
  invoiceNumber        String        @unique
  clientId             Int?
  clientName           String
  clientCompany        String?
  clientEmail          String?
  clientPhone          String?
  clientAddress        String?       @db.Text
  stripeAccountId      Int?
  stripeAccount        StripeAccount? @relation(fields: [stripeAccountId], references: [id])
  brandId              Int?
  items                Json
  currency             String        @default("gbp")
  subtotal             Decimal       @db.Decimal(10, 2)
  discountAmount       Decimal?      @db.Decimal(10, 2)
  taxPercent           Decimal?      @db.Decimal(5, 2)
  taxAmount            Decimal?      @db.Decimal(10, 2)
  total                Decimal       @db.Decimal(10, 2)
  notes                String?       @db.Text
  terms                String?       @db.Text
  dueDate              DateTime?
  status               InvoiceStatus @default(draft)
  paymentMethod        String        @default("stripe")
  showBankName         Boolean       @default(true)
  bankName             String?
  bankAccountName      String?
  bankAccountNumber    String?
  bankSortCode         String?
  bankIban             String?
  bankSwift            String?
  stripePaymentLinkId  String?
  stripePaymentLinkUrl String?
  paidAt               DateTime?
  sentAt               DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model BankAccount {
  id            Int      @id @default(autoincrement())
  label         String
  bankName      String?
  accountName   String?
  accountNumber String?
  sortCode      String?
  iban          String?
  swift         String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
}

model SyncLog {
  id              Int      @id @default(autoincrement())
  ranAt           DateTime @default(now())
  rowsProcessed   Int
  clientsCreated  Int
  clientsUpdated  Int
  servicesUpserted Int
  warnings        Json
}
